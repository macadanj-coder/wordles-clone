Board {
    align: center middle;
    height: 1fr;
}

GuessRow {
    height: auto;
    width: auto;
}

Tile {
    width: 7;
    height: 3;
    margin: 0 1 1 0;
    content-align: center middle;
    text-style: bold;
    border: tall $panel;
    background: $surface;
}

Tile.-filled {
    border: tall $foreground 50%;
}

Tile.-correct {
    background: green;
    border: tall green;
}

Tile.-present {
    background: yellow;
    border: tall yellow;
}

Tile.-absent {
    background: $panel-darken-2;
    border: tall $panel-darken-2;
}

Keyboard {
    height: auto;
    align: center top;
    margin-bottom: 1;
}

.key-row {
    height: auto;
    width: 100%;
    align: center top;
    margin-bottom: 1;
}

Key {
    width: 5;
    height: 3;
    margin: 0 1 0 0;
    content-align: center middle;
    text-style: bold;
    background: $panel-lighten-2;
}

Key.-wide {
    width: 8;
}

Key.-correct {
    background: green;
}

Key.-present {
    background: yellow;
}

Key.-absent {
    background: $panel-darken-2;
}
